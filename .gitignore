# vendor/ and public/build are committed deliberately: the cPanel deploy
# target (see deploy/README.md) can't run composer/npm on the server,
# so master must always carry a pre-built, ready-to-serve tree.
deploy/.deploy-config.php
deploy/.initialized
deploy/.last-sha

# Firebase service account private key + VAPID material - real secrets,
# never committed. The values that actually need to be readable at
# runtime are copied into .env (also gitignored) instead.
/firebaseconfig

# Internal dev-only progress tracker for the current work batch - never
# meant to ship, just a running local note of what's done/pending.
/PROGRESS.local.md
