APP_NAME=Meet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meet
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log writes emails to storage/logs instead of sending them
# - the safe zero-config default for a fresh install. Once you set real
# SMTP credentials below, you MUST change this to `smtp` or nothing will
# actually be delivered (registration OTP, meeting invites, archive
# emails, etc. will all silently just log). This exact mismatch - real
# credentials configured but MAIL_MAILER left on `log` - is a real
# mistake that happened during this project's own setup.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Real OS-level push notifications go through Firebase Cloud Messaging.
# FIREBASE_PROJECT_ID/CLIENT_EMAIL/PRIVATE_KEY come from a Firebase
# service account key (Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key) - used server-side to send.
# FIREBASE_VAPID_KEY is a *different* value (Project Settings -> Cloud
# Messaging -> Web configuration -> Web Push certificates) - used
# client-side to request a device token. FIREBASE_API_KEY/AUTH_DOMAIN/
# STORAGE_BUCKET/MESSAGING_SENDER_ID/APP_ID are the plain client config
# (Project Settings -> General -> Your apps -> Web app) - not secret,
# safe to ship in client JS like any Firebase web app does. Push
# notifications silently no-op without these set (nothing crashes,
# they just never send) rather than failing installs that don't need them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_VAPID_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# "Continue with Google" needs an OAuth 2.0 Client ID from
# https://console.cloud.google.com/apis/credentials, with
# GOOGLE_REDIRECT_URI added to that client's Authorized redirect URIs
# (must be {APP_URL}/auth/google/callback exactly). Silently hidden
# from the login page without these set, same as Web Push above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"

# Meet Insights entry link (Insights > Control center > Integrations > Meet > shared secret)
INSIGHTS_SSO_SECRET=
# Free Meet tools on Meet Insights: same value as TOOLS_PASS_SECRET in Insights (signs the sign-up pass)
TOOLS_PASS_SECRET=
TOOLS_PASS_HOSTS=example.com,example.net,example.in,example.org,example.biz
INSIGHTS_SSO_AUDIENCE=meet

# Meet Mail (Documentation/MAIL/MAIL_CPANEL_SETUP.md). Empty domain = no own addresses (external accounts still work)
MEET_MAIL_DOMAIN=example.com
MEET_MAIL_SUFFIX=.user
MEET_MAIL_ALIAS_DOMAINS=example.net
MEET_MAIL_FREE_MB=30
MEET_MAIL_ARCHIVE_DAYS=30
MEET_MAIL_MAX_MESSAGE_MB=20
MEET_MAIL_GOOGLE_REDIRECT=
INSIGHTS_URL=https://github.com/imsahiraf/meet

# cPanel API of this account: mail:cpanel-setup points the example.com catch-all at Meet on every update (cPanel > Security > Manage API Tokens)
CPANEL_USER=
CPANEL_API_TOKEN=

# Failed auto-updates are mailed here (and to the super admin)
UPDATE_ALERT_EMAIL=
